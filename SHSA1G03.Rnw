\section{Description of missingness}

<<libraries, include=FALSE>>=
### libraries related to knit:
library(knitr)
library(xtable)     # to create nice LaTeX tables
@

<<data, include=FALSE>>=
load("C:/Users/alexv/Desktop/MatCAD_Quart/Mètodes d’Anàlisi en Ciències de la Salut/Entreges/SHS_Assignment_1/Cluster-Analysis-with-missing-data/copd_redux.RData")

# load("/home/rogerg/Cluster-Analysis-with-missing-data/copd_redux.RData")
@

<<missingness, echo=TRUE>>=

n_participants <- nrow(copd)
n_variables <- ncol(copd)
missing_per_variable <- colMeans(is.na(copd)) * 100

min_missing <- sprintf("%.1f", min(missing_per_variable))
max_missing <- sprintf("%.1f", max(missing_per_variable))

pct_variables_lt5 <- sprintf("%.1f", mean(missing_per_variable < 5) * 100) # mean calcula la proporció de true
# equivalent: AA <- sprintf("%.1f", sum((missing_per_variable < 5))/n_variables * 100) # true=1, false=0
 
pct_complete_cases <- sprintf("%.1f", mean(complete.cases(copd)) * 100)
pct_missing_total <- sprintf("%.1f", mean(is.na(as.matrix(copd))) * 100)

total_cells <- prettyNum(n_participants * n_variables, big.mark=",") # n_participants * n_variables = total_cells
@

The subset used here included \Sexpr{n_participants} participants and \Sexpr{n_variables} variables. The range of missing data in the different variables went from \Sexpr{min_missing}\% to \Sexpr{max_missing}\%, with \Sexpr{pct_variables_lt5}\% of the variables having less than 5\% of the data missing. Only \Sexpr{pct_complete_cases}\% of the participants had complete data on all \Sexpr{n_variables} variables. Overall, \Sexpr{pct_missing_total}\% of the information was missing; that is, \Sexpr{pct_missing_total}\% of the total of
\Sexpr{total_cells} cells (\Sexpr{n_variables} x \Sexpr{n_participants} = \Sexpr{total_cells}) had missing data.






\section{Multiple imputation}



<<multiple_imputation, include=FALSE>>=

library(mice)
mice::md.pattern(copd, rotate.names = TRUE)

M <- 100
ini <- mice(copd, maxit = 0)
# ?mice
ini
# id es fa servir per inferir, id, quo_calcpostv1 i fvcp_postv1 no tenen forats.
# s'ha d'estudiar la possibilitat de variables depenents deterministicament, és 
# la classe de putada que ens faria el professor.
# estudiar també els metodes proposats.

# potser amb ignore és més bonic però no el fa servir als apunts
pred <- ini$predictorMatrix
pred["id", ] <- 0 # we don't want "id" to be imputed
pred[, "id"] <- 0 # we don't want "id" to be predictor
pred

imp <- mice(copd,
            m = M,
            method = ini$meth,
            predictorMatrix = pred,
            printFlag = FALSE,
            seed = 666)
imp
imp$imp

resultat_mice<-complete(imp, action="all", include=TRUE)

# factor amb ordre -> as.numeric(levels(f))[f]
# factor sense ordre -> one_hot_encoding
# de moment faig tot amb ordre
# sin11_v1 iam_chv1 sin15_v1 sin7_v1 sin8_v1 cccs1_v0 vtit_catv1 urg_ambv0 sin5_v1 sin6_v1 graudisn_v1
# tots 1 menys graudisn_v1 que té 6.
categorics_amb_ordre <- c("sin11_v1", "iam_chv1", "sin15_v1", "sin7_v1", "sin8_v1","cccs1_v0", "vtit_catv1", "urg_ambv0", "sin5_v1", "sin6_v1")
categorics_sense_ordre <- c("graudisn_v1")
for (i in 1:(M+1))
{
  for (j in categorics_amb_ordre)
  {
    resultat_mice[[i]][[j]] <- as.numeric(levels(resultat_mice[[i]][[j]]))[resultat_mice[[i]][[j]]]
  }
  for (j in categorics_sense_ordre)
  {
    #nomes hi ha graudisn_v1 i per tant programaré el onehot nomes si és estrictament necessari.
    resultat_mice[[i]][[j]] <- as.numeric(levels(resultat_mice[[i]][[j]]))[resultat_mice[[i]][[j]]]
  }
}

library(miclust)
miclustdata<-getdata(resultat_mice)

# ------------MULTIPLE IMPUTATION ACABA AQUI------------
res_mi_clust<-miclust(miclustdata, search = "backward", ks=2:10)
@


